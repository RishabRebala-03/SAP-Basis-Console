# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-flask-session-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
PORT=5000
HOST=0.0.0.0

# Database Configuration
MONGO_URI=mongodb://localhost:27017/sap_basis_console
MONGO_DB=sap_basis_console

# SAP OData Integration Settings
# Set to 'true' to use local mock data without a live SAP instance
SAP_MOCK=true

# SAP System Configurations (Configured for multiple systems: SHD, EMP, EMQ, EMD)
SAP_SHD_URL=https://sap-gateway-shd.example.com/sap/opu/odata/sap/ZUSER_MANAGEMENT_SRV/
SAP_SHD_USER=BASIS_ADMIN
SAP_SHD_PASS=SHD_Password_123
SAP_SHD_CLIENT=100

SAP_EMP_URL=https://sap-gateway-emp.example.com/sap/opu/odata/sap/ZUSER_MANAGEMENT_SRV/
SAP_EMP_USER=BASIS_ADMIN
SAP_EMP_PASS=EMP_Password_123
SAP_EMP_CLIENT=200

SAP_EMQ_URL=https://sap-gateway-emq.example.com/sap/opu/odata/sap/ZUSER_MANAGEMENT_SRV/
SAP_EMQ_USER=BASIS_ADMIN
SAP_EMQ_PASS=EMQ_Password_123
SAP_EMQ_CLIENT=300

SAP_EMD_URL=https://sap-gateway-emd.example.com/sap/opu/odata/sap/ZUSER_MANAGEMENT_SRV/
SAP_EMD_USER=BASIS_ADMIN
SAP_EMD_PASS=EMD_Password_123
SAP_EMD_CLIENT=400
